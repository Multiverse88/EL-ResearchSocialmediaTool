# ========================================================
# EasyCorp Social Media Intelligence & Open WebUI Config
# Copy this file to .env or paste into Dokploy Environment Tab
# ========================================================

# 0. Bright Data Scraper API token (RECOMMENDED — reliable Instagram & TikTok scraping)
# Create an API token in https://brightdata.com/cp/setting/users and enable the
# Instagram Posts, Instagram Reels, and TikTok Posts Scraper APIs.
# Broad Instagram topic discovery also uses a Bright Data SERP API zone.
# When unset, profile scrapers fall back to anonymous Instaloader/HTML paths (fragile
# and commonly rate-limited from VPS IPs); broad Instagram topic discovery is unavailable.
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_SERP_ZONE=

# 1. Claude API Credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 2. Database Storage Path
DATABASE_PATH=social_media.db

# 3. Instagram Scraper Credentials — fallback path (used when BRIGHT_DATA_API_TOKEN is unset)
# Instaloader works anonymously without these, but Instagram blocks/rate-limits anonymous
# scraping from most VPS IPs almost immediately. Logging in with a real account fixes this
# at zero recurring cost:
#   1. Create a dedicated "burner" Instagram account (do NOT use a personal/brand account —
#      it risks a temporary action block while scraping). Verify it with a real phone/email;
#      Instagram requires this for new accounts.
#   2. Use the account normally for a few days first (follow a handful of accounts, like a
#      few posts) so it doesn't look brand-new to Instagram's anti-bot systems.
#   3. Fill in the username/password below and redeploy. Instaloader logs in and reuses the
#      session going forward (stored at INSTAGRAM_SESSION_FILE), so the password is only
#      needed again if the session expires or the account gets logged out.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_FILE=

# 4. TikTok Scraper — fallback path (used when BRIGHT_DATA_API_TOKEN is unset)
# Dispatch order per scrape: Bright Data (if token set) > TikTokApi/Playwright (headless
# Chromium bundled in the Docker image) > raw HTML parsing (last-resort fallback if
# Playwright/Chromium isn't available).
# TIKTOK_MS_TOKEN is optional — grab the `msToken` cookie value from a logged-in browser
# session on tiktok.com to make the Playwright path more reliable; TikTokApi works without
# it by generating its own session cookies through the real Chromium browser, just less
# reliably over long scraping runs.
TIKTOK_MS_TOKEN=
TIKTOK_SESSION_COOKIE=

# 5. Scraper Limits & Schedules
MAX_POSTS_PER_SCRAPE=30

# 5b. Live Scrape-on-Chat (fetches fresh data automatically when AI chat answers a topic
# question with no/stale data — trades response latency + scraper quota for freshness).
# Set to "false" to disable and only ever answer from data scraped via Scheduled Jobs /
# the dashboard's manual "Scrape Sekarang" button.
ENABLE_LIVE_SCRAPE_ON_CHAT=true
# How old a topic's newest scraped post can be before chat triggers a fresh scrape.
# Lower = fresher answers but more Bright Data quota usage / higher block risk on the free
# self-hosted paths (Instagram anonymous scraping, repeated TikTok requests).
TOPIC_STALENESS_HOURS=6

# 6. API Security (Optional — leave unset for zero-config internal-team default)
# When set, POST /accounts, /topics, /topics/scrape, /scrape/run, /api/seed-sample-data
# require an X-API-Key header (or Authorization: Bearer <key>) matching this value.
API_SECRET_KEY=
# Chat can translate natural-language messages into Bright Data scrapes and monitoring
# mutations (see src/chat_actions.py) — e.g. "ganti akun EasyLegal jadi @id.easylegal"
# actually renames the monitored account and scrapes it. When set, POST /chat and
# POST /v1/chat/completions require an X-API-Key header (or Authorization: Bearer
# <key>) matching this value. Set this AND configure it as your OpenWebUI instance's
# OPENAI_API_KEY (see docker-compose.yml) so only your internal OpenWebUI can trigger
# chat-driven actions/provider spend. Left unset, chat stays open (matches this project's
# zero-config default) but the gap is logged as a warning on startup.
CHAT_ACTION_API_KEY=
# Comma-separated list of allowed browser origins for CORS (defaults to the deployed
# Open WebUI domain + localhost dev origins if left unset).
ALLOWED_ORIGINS=
# Max chat messages per IP per minute (protects 9router/AI budget from abuse/loops).
CHAT_RATE_LIMIT_PER_MINUTE=20
