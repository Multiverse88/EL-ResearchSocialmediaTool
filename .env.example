# ========================================================
# EasyCorp Social Media Intelligence & Open WebUI Config
# Copy this file to .env or paste into Dokploy Environment Tab
# ========================================================

# 0. Apify Scraper Token (RECOMMENDED — reliable Instagram & TikTok scraping)
# Get a token at https://console.apify.com/settings/integrations
# When set, scrapers use Apify's `apify/instagram-scraper` and `clockworks/tiktok-scraper`
# actors (their own residential proxies, not blockable from this VPS's IP).
# When unset, scrapers fall back to free anonymous Instaloader/HTML scraping (fragile,
# gets 429/blocked from most VPS IPs).
APIFY_API_TOKEN=

# 1. Claude API Credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 2. Database Storage Path
DATABASE_PATH=social_media.db

# 3. Instagram Scraper Credentials (Optional, for higher rate limits)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_FILE=

# 4. TikTok Scraper Tokens (Optional, for web verification)
TIKTOK_MS_TOKEN=
TIKTOK_SESSION_COOKIE=

# 5. Scraper Limits & Schedules
MAX_POSTS_PER_SCRAPE=30

# 6. API Security (Optional — leave unset for zero-config internal-team default)
# When set, POST /accounts, /topics, /topics/scrape, /scrape/run, /api/seed-sample-data
# require an X-API-Key header (or Authorization: Bearer <key>) matching this value.
API_SECRET_KEY=
# Comma-separated list of allowed browser origins for CORS (defaults to the deployed
# Open WebUI domain + localhost dev origins if left unset).
ALLOWED_ORIGINS=
# Max chat messages per IP per minute (protects 9router/AI budget from abuse/loops).
CHAT_RATE_LIMIT_PER_MINUTE=20
